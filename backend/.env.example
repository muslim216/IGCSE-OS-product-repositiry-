# Copy to .env and fill in real values.

# Postgres (docker compose default). Tests override this with SQLite automatically.
DATABASE_URL=postgresql+asyncpg://igcse:igcse@localhost:5432/igcse

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Required for AI features (marking, extraction, chat, reports).
# The app runs without it; AI jobs fail gracefully with a clear error.
ANTHROPIC_API_KEY=

# Comma-separated allowed origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# --- Google Classroom import (optional) ---
# Without these the feature reports itself as unconfigured; nothing else breaks.
# Set up at console.cloud.google.com: create a project, enable the Google
# Classroom API AND the Google Drive API, configure the OAuth consent screen,
# then create a Web application OAuth client whose authorised redirect URI
# exactly matches GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback
# Encrypts stored Google refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=
