# Copy to .env and fill in real values.

# Postgres (docker compose default). Tests override this with SQLite automatically.
DATABASE_URL=postgresql+asyncpg://igcse:igcse@localhost:5432/igcse

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Required for the Anthropic-routed AI surfaces (reports, readiness
# synthesis, class brief, narrative). The app runs without it; those AI jobs
# fail gracefully with a clear error.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# **No surface routes to Gemini as of task 3.2** (AV-124). Both settings and the
# client in app/services/ai.py are kept, unused, on purpose: retiring a provider
# is a routing decision, and deleting the code path in the same change would
# make going back a rewrite rather than a config edit. You do not need a Gemini
# key to run Avora. If you do point a surface back at it, set GEMINI_MODEL to a
# real model id — the default below is only a placeholder.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Per-surface model routing (see app/services/ai.py resolve_surface).
# *_PROVIDER is "anthropic" or "gemini"; a **blank** *_MODEL inherits
# ANTHROPIC_MODEL above, so those surfaces move together whenever it moves. An
# explicit model pins a surface that diverges on purpose and has to be edited by
# hand. Blank is not "unset" — it means "follow the default".
AI_MARKING_PROVIDER=anthropic
AI_MARKING_MODEL=
AI_EXTRACTION_PROVIDER=anthropic
AI_EXTRACTION_MODEL=
AI_SYLLABUS_PROVIDER=anthropic
AI_SYLLABUS_MODEL=
AI_REPORTS_PROVIDER=anthropic
AI_REPORTS_MODEL=claude-sonnet-5
AI_READINESS_PROVIDER=anthropic
AI_READINESS_MODEL=
AI_CLASS_BRIEF_PROVIDER=anthropic
AI_CLASS_BRIEF_MODEL=claude-sonnet-5
AI_NARRATIVE_PROVIDER=anthropic
AI_NARRATIVE_MODEL=claude-sonnet-5

# Per-token prices keyed by the real model IDs in config.py / services/ai.py,
# in USD per million tokens. Kept as JSON so a price change is a config change,
# not a code change (AI-17: a model with no entry records cost_usd = NULL and
# reports as unpriced, never $0). This file is the reference value; paste it
# into the Render dashboard, which is where the deployed value lives.
#
# Keyed to AV-124's routing, not today's: Gemini is retired from every surface
# and all seven live ones route to Claude 5 — Opus 5 for marking, extraction,
# syllabus and readiness, Sonnet 5 for reports, class brief and narrative.
# `chat` (claude-haiku-4-5) was deleted by AV-57 / task 0.3, config and all —
# it is not a surface any more and carries no price entry.
#
# Task 3.2 has now landed, so this table and config.py agree: every live surface
# resolves to a model priced here. claude-opus-4-8 is gone — it was priced only
# because it was anthropic_model's default until 3.2 bumped it, and a key that
# matches no configured model prices nothing.
#
# **If you deploy this, check the AI_MODEL_PRICING already set in Render.** It
# is `sync: false`, so it is whatever was typed there, not what is written here.
# A deployed value that prices only claude-opus-4-8 will record cost_usd = NULL
# for every call after this change and report them as unpriced — correct
# behaviour under AI-17, and completely useless for knowing what a tutor costs.
#
# Every rate is transcribed from Anthropic's own current price list, checked
# 23 Aug 2026 — never carried over from an earlier task or inferred from a
# sibling model. RE-CHECK BEFORE COPYING: rates move, and a stale number here
# is reported to the owner as real money.
#   claude-opus-5    $5 / $25   platform.claude.com/docs/en/about-claude/pricing
#   claude-sonnet-5  $2 / $10   same page. $2/$10 is the standard price; the
#                               $3/$15 rise once scheduled for 1 Sep 2026 was
#                               cancelled, so do not "correct" it upward.
AI_MODEL_PRICING={"claude-opus-5": {"input_per_1m": 5, "output_per_1m": 25}, "claude-sonnet-5": {"input_per_1m": 2, "output_per_1m": 10}}

# Comma-separated allowed origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# The refresh-token cookie is Secure by default (HTTPS only), which browsers
# drop on plain-HTTP local dev. Set to false for local http://localhost dev only.
REFRESH_COOKIE_SECURE=true

# Readiness Engine v2 is what the readiness UI/API serve. This is a kill
# switch, not a shadow flag: set it to false to stop v2 runs being computed,
# and readiness falls back to the v1 engine rather than breaking. Kept under
# its original name so existing deployments keep working.
READINESS_V2_SHADOW_ENABLED=true

# Readiness v2 synthesis is an expensive AI call. Triggers for the same
# (student, subject) collapse into a single run scheduled this many seconds
# after the first trigger in a burst, so auto-marking a class's homework
# costs one synthesis per student rather than one per submission.
READINESS_V2_COALESCE_SECONDS=600

# Google Classroom integration (see app/services/google_classroom.py). Both
# unset -> the feature reports "not configured" and the app runs fine
# without it, same as ANTHROPIC_API_KEY. From a Google Cloud project's
# OAuth 2.0 Client, with the Classroom and Drive (readonly) APIs enabled and
# GOOGLE_REDIRECT_URI added as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/settings/classroom/callback
# Encrypts stored Google refresh tokens at rest. Optional: falls back to a
# key derived from JWT_SECRET when unset. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# File storage (task 1.2, AV-82). "local" writes under UPLOAD_DIR and is the
# default — the app runs fully without any of the S3_* values below. Set to
# "s3" to target any S3-compatible store (AWS S3, Cloudflare R2, MinIO); the
# interface has no vendor-specific code path (docs/av-82-architecture-impact-
# report.md). `docker compose --profile full up` runs a local MinIO and sets
# these for you — see docker-compose.yml. Signed URLs (threat review F3) are
# only ever minted for tutor material, never for student submissions, which
# always proxy through the API regardless of this setting.
# The job worker runs inside the API process by default, which is the
# deployment today. Task 1.3 (AV-82) also makes it runnable on its own with
# `python -m app.workers`. Set this false ONLY together with actually running
# that service: an API with no worker and no worker service means marking,
# extraction, readiness and reports all stop with no error anywhere —
# /health/ready reporting `not_started` is the only signal.
RUN_WORKER_IN_API=true

STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# Shared rate-limit counters (task 1.4, AV-83). Unset — the default — keeps the
# failed-login counters in process memory, which is correct while the API runs
# one instance and is the right setting for local development and tests. Set it
# and every instance enforces ONE limit instead of one each.
#
# REDIS IS FOR RATE-LIMIT COUNTERS AND NOTHING ELSE (E18). Postgres stays the
# source of truth for all application state; a second use of Redis is its own
# decision, not an extension of this one.
#
# A configured Redis that stops answering degrades to the in-process counter and
# raises an alarm (/api/v1/health/ready reports `rate_limit.degraded` and
# answers 503) rather than blocking logins — threat review F4. It never becomes
# an authentication dependency in either direction.
#
# `docker compose --profile full up -d redis` runs one locally.
REDIS_URL=
# How long a Redis call may take before the limiter gives up and falls back.
# Sub-second on purpose: this bound sits in front of the login endpoint.
REDIS_TIMEOUT_SECONDS=0.25
