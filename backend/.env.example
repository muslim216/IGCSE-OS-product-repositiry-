# Copy to .env and fill in real values.

# Postgres (docker compose default). Tests override this with SQLite automatically.
DATABASE_URL=postgresql+asyncpg://igcse:igcse@localhost:5432/igcse

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Required for the Anthropic-routed AI surfaces (chat, reports, readiness
# synthesis). The app runs without it; those AI jobs fail gracefully with a
# clear error.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Required for the Gemini-routed AI surfaces — by default marking, question
# extraction and syllabus extraction (the bulk document work). Same graceful
# degradation as ANTHROPIC_API_KEY. Set GEMINI_MODEL to the real model id you
# have access to; the default below is only a placeholder.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Per-surface model routing (see app/services/ai.py resolve_surface).
# *_PROVIDER is "anthropic" or "gemini"; leaving *_MODEL blank uses that
# provider's default model above. Flip marking/extraction back to anthropic
# to ship before you have a Gemini key.
AI_MARKING_PROVIDER=gemini
AI_MARKING_MODEL=
AI_EXTRACTION_PROVIDER=gemini
AI_EXTRACTION_MODEL=
AI_SYLLABUS_PROVIDER=gemini
AI_SYLLABUS_MODEL=
AI_CHAT_PROVIDER=anthropic
AI_CHAT_MODEL=claude-haiku-4-5
AI_REPORTS_PROVIDER=anthropic
AI_REPORTS_MODEL=
AI_READINESS_PROVIDER=anthropic
AI_READINESS_MODEL=
AI_CLASS_BRIEF_PROVIDER=anthropic
AI_CLASS_BRIEF_MODEL=

# Per-token prices keyed by the real model IDs in config.py / services/ai.py
# (see AI_MODEL_PRICING handling in services/ai.py). Kept as JSON so a
# price change is a config change, not a code change. A model with no entry
# records cost_usd = NULL — the analytics endpoint reports it as unpriced
# rather than inventing $0. Update both this file and render.yaml when you
# change a model id.
AI_MODEL_PRICING={"claude-opus-4-8": {"input_per_1m": 5, "output_per_1m": 25}, "claude-haiku-4-5": {"input_per_1m": 3, "output_per_1m": 15}, "gemini-2.5-pro": {"input_per_1m": 1.25, "output_per_1m": 10}}

# Comma-separated allowed origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# The refresh-token cookie is Secure by default (HTTPS only), which browsers
# drop on plain-HTTP local dev. Set to false for local http://localhost dev only.
REFRESH_COOKIE_SECURE=true

# Readiness Engine v2 is what the readiness UI/API serve. This is a kill
# switch, not a shadow flag: set it to false to stop v2 runs being computed,
# and readiness falls back to the v1 engine rather than breaking. Kept under
# its original name so existing deployments keep working.
READINESS_V2_SHADOW_ENABLED=true

# Readiness v2 synthesis is an expensive AI call. Triggers for the same
# (student, subject) collapse into a single run scheduled this many seconds
# after the first trigger in a burst, so auto-marking a class's homework
# costs one synthesis per student rather than one per submission.
READINESS_V2_COALESCE_SECONDS=600

# Google Classroom integration (see app/services/google_classroom.py). Both
# unset -> the feature reports "not configured" and the app runs fine
# without it, same as ANTHROPIC_API_KEY. From a Google Cloud project's
# OAuth 2.0 Client, with the Classroom and Drive (readonly) APIs enabled and
# GOOGLE_REDIRECT_URI added as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/settings/classroom/callback
# Encrypts stored Google refresh tokens at rest. Optional: falls back to a
# key derived from JWT_SECRET when unset. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
